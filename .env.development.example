# Copy to .env.development.local only if changing the defaults.
SELF_STUDY_PORT=4180
SELF_STUDY_FRONTEND_PORT=51721
# Relative to the project root. Existing data/ is not modified.
SELF_STUDY_DATA_DIR=data-dev
# Optional absolute path to an official Codex executable.
# SELF_STUDY_CODEX=/absolute/path/to/codex

# Optional: reuse an installed Python environment; otherwise use .venv/bin/python.
# SELF_STUDY_BOOK_PYTHON=/absolute/path/to/venv/bin/python
# SELF_STUDY_LIBRARY_PYTHON=/absolute/path/to/venv/bin/python
# SELF_STUDY_BOOK_BASE_ENV=/absolute/path/to/venv
